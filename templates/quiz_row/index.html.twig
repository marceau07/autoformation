{% extends 'base.html.twig' %}

{% block title %}
  QuizRow index
{% endblock %}

{% block body %}
  <h1>QuizRow index</h1>

  <table class="table">
    <thead>
      <tr>
        <th>Id</th>
        <th>Uuid</th>
        <th>Question</th>
        <th>Option1</th>
        <th>Option2</th>
        <th>Option3</th>
        <th>Option4</th>
        <th>Quiz_type</th>
        <th>Timer</th>
        <th>Score</th>
        <th>Hint</th>
        <th>Answer_explanation</th>
        <th>actions</th>
      </tr>
    </thead>
    <tbody>
      {% if quiz_row is defined and quiz_row is not empty %}
        {% for quiz_row in quiz_rows %}
          <tr>
            <td>{{ quiz_row.id }}</td>
            <td>{{ quiz_row.uuid }}</td>
            <td>{{ quiz_row.question }}</td>
            <td>{{ quiz_row.option1 }}</td>
            <td>{{ quiz_row.option2 }}</td>
            <td>{{ quiz_row.option3 }}</td>
            <td>{{ quiz_row.option4 }}</td>
            <td>{{ quiz_row.quizType }}</td>
            <td>{{ quiz_row.timer }}</td>
            <td>{{ quiz_row.score }}</td>
            <td>{{ quiz_row.hint }}</td>
            <td>{{ quiz_row.answerExplanation }}</td>
            <td>
              <a href="{{ path('app_quiz_row_show', { id: quiz_row.id }) }}">show</a>
              <a href="{{ path('app_quiz_row_edit', { id: quiz_row.id }) }}">edit</a>
            </td>
          </tr>
        {% endfor %}
      {% else %}
        <tr>
          <td colspan="13">no records found</td>
        </tr>
      {% endif %}
    </tbody>
  </table>

  <a href="{{ path('app_quiz_row_new') }}">Create new</a>
{% endblock %}
