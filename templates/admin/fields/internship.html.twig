{% trans_default_domain 'admin' %}
{% set title = '' %}
{% set color = 'light' %}
{% set disabled = true %}

{% if entity.instance.agreement == null or entity.instance.agreement == false %}
  {% set title = 'admin.pages.trainees_internships.asking_elements.missing_agreement'|trans %}
  {% set color = 'light' %}
  {% set disabled = true %}
{% elseif entity.instance.agreement %}
  {% set title = 'admin.pages.trainees_internships.asking_elements.label'|trans %}
  {% set color = 'primary' %}
  {% set disabled = false %}
{% endif %}

<a href="{{ path('app_internships_asking_elements', { traineeInternshipId: entity.instance.id }) }}" target="_blank" class="btn btn-{{ color }} {{ disabled }}" title="{{ title }}"><i class="fa-solid fa-paper-plane"></i></a>
