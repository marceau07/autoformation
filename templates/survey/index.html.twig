{% extends 'base.html.twig' %}

{% block title %}
  {{ 'survey.heading'|trans }}
{% endblock %}

{% block stylesheets %}
  <link rel="stylesheet" href="{{ asset('css/survey.css') }}" />
{% endblock %}

{% block main %}
  <div class="container">
    <div class="row">
      <h1>{{ 'survey.heading'|trans }}</h1>
      <p>
        {{ 'survey.intro'|trans|raw }}
      </p>
      {% if questions is defined and questions is not empty %}
        <form action="{{ path('app_survey') }}" class="mb-3" method="POST">
          {% for key, question in questions %}
            <input type="hidden" name="questionnaire_id_{{ key }}" value="{{ question.id }}" />
            <div class="col-12">
              <p class="fw-bold">
                {{ question.question }}<span class="required">*</span>
              </p>
              <div class="emojis">
                <label class="form-check-label" for="very_unsatisfied_{{ question.id }}">
                  <input type="radio" class="form-check-input d-none" id="very_unsatisfied_{{ question.id }}" name="satisfaction_{{ key }}" value="1" />
                  <img src="{{ asset('surveys/very_unsatisfied.png') }}" alt="{{ 'survey.emojis.very_unsatisfied'|trans }}" />
                </label>
                <label class="form-check-label" for="unsatisfied_{{ question.id }}">
                  <input type="radio" class="form-check-input d-none" id="unsatisfied_{{ question.id }}" name="satisfaction_{{ key }}" value="2" />
                  <img src="{{ asset('surveys/unsatisfied.png') }}" alt="Insati{{ 'survey.emojis.unsatisfied'|trans }}sfait" />
                </label>
                <label class="form-check-label" for="neutral_{{ question.id }}">
                  <input type="radio" class="form-check-input d-none" id="neutral_{{ question.id }}" name="satisfaction_{{ key }}" value="3" />
                  <img src="{{ asset('surveys/neutral.png') }}" alt="{{ 'survey.emojis.neutral'|trans }}" />
                </label>
                <label class="form-check-label" for="satisfied_{{ question.id }}">
                  <input type="radio" class="form-check-input d-none" id="satisfied_{{ question.id }}" name="satisfaction_{{ key }}" value="4" />
                  <img src="{{ asset('surveys/satisfied.png') }}" alt="{{ 'survey.emojis.satisfied'|trans }}" />
                </label>
                <label class="form-check-label" for="very_satisfied_{{ question.id }}">
                  <input type="radio" class="form-check-input d-none" id="very_satisfied_{{ question.id }}" name="satisfaction_{{ key }}" value="5" />
                  <img src="{{ asset('surveys/very_satisfied.png') }}" alt="{{ 'survey.emojis.very_satisfied'|trans }}" />
                </label>
              </div>
              <div>
                <label for="commentary_{{ question.id }}">{{ 'survey.commentary'|trans }}</label>
                <textarea id="commentary_{{ question.id }}" name="commentary_{{ key }}" rows="5" cols="50" class="form-control"></textarea>
              </div>
            </div>
            <hr />
          {% endfor %}
          <br />
          <button type="submit" class="btn btn-primary">{{ 'global.btn_send'|trans }}</button>
        </form>
      {% else %}
        <p>{{ 'survey.no_questions'|trans }}</p>
      {% endif %}
    </div>
  </div>
{% endblock %}
