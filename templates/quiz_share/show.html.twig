{% extends 'base.html.twig' %}

{% block title %}QuizShare{% endblock %}

{% block main %}
  <div class="container-fluid">
    <div class="row flex-start">
      <div class="col-3 mt-2 mb-2 text-start">
        <a href="{{ path('app_quiz_index') }}" class="btn btn-success">{{ 'global.btn_back'|trans }}</a>
      </div>
      <div class="col-6 text-center mt-2 mb-2">
        <h1>Quiz Share</h1>
      </div>
      <div class="col-3 mt-2 mb-2 text-end">
        <a href="{{ path('app_quiz_share_edit', { id: quiz_share.id }) }}" class="btn btn-warning">{{ 'global.btn_edit'|trans }}</a>
      </div>
    </div>
    <div class="row">
      <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ quiz_share.id }}</td>
            </tr>
            <tr>
                <th>Start_date</th>
                <td>{{ quiz_share.startDate ? quiz_share.startDate|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>Finish_date</th>
                <td>{{ quiz_share.finishDate ? quiz_share.finishDate|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
        </tbody>
      </table>
    </div>

    {{ include('quiz_share/_delete_form.html.twig') }}
  </div>
{% endblock %}