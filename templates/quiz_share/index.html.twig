{% extends 'base.html.twig' %}

{% block title %}QuizShare index{% endblock %}

{% block main %}
    <div class="container-fluid mb-3">
        <div>
            {% include '_components/_subnavbarAdmin.html.twig' with {'choosenElement': "quiz"} %}
        </div>
    
        <div class="tab-content">
            <div class="tab-pane container-fluid active">
                <div class="mt-2 mb-2">
                    <a role="button" class="btn btn-primary" href="{{ path('app_quiz_share_new') }}"><i class="fa-solid fa-link"></i>&nbsp;{{ 'global.btn_add'|trans }}</a>
                </div>
                <div>
                    <table class="table table-bordered table-striped display responsive nowrap" style="margin: 0 auto;" id="list_quiz_share">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Id</th>
                                <th>Start_date</th>
                                <th>Finish_date</th>
                            </tr>
                        </thead>
                        <tbody>
                        {% for quiz_share in quiz_shares %}
                            <tr>
                                <td>
                                    <a href="{{ path('app_quiz_share_show', {'id': quiz_share.id }) }}"><i class="fas fa-eye"></i></a>
                                    <a href="{{ path('app_quiz_share_edit', {'id': quiz_share.id }) }}"><i class="fas fa-pen"></i></a>
                                </td>
                                <td>{{ quiz_share.id }}</td>
                                <td>{{ quiz_share.startDate ? quiz_share.startDate|date('Y-m-d H:i:s') : '' }}</td>
                                <td>{{ quiz_share.finishDate ? quiz_share.finishDate|date('Y-m-d H:i:s') : '' }}</td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="4">no records found</td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
