{% extends 'base.html.twig' %}

{% block title %}
  {{ 'home.welcome'|trans({ '%platformName%': platformName }) }}
{% endblock %}

{% block stylesheets %}
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@splidejs/splide@4.1.4/dist/css/splide.min.css" />
  <link rel="stylesheet" href="{{ asset('css/index.css') }}" />
{% endblock %}

{% block javascripts %}
  <script src="https://cdn.jsdelivr.net/npm/@splidejs/splide@4.1.4/dist/js/splide.min.js"></script>
{% endblock %}

{% block main %}
  <div class="container">
    <div class="row">
      <div class="col-12 mt-3">
        <h1 class="text-center">{{ 'home.welcome'|trans({ '%platformName%': platformName }) }}</h1>
        <p class="text-center text-small">{{ 'home.welcome_small'|trans }}</p>
      </div>
    </div>

    {% if satisfactionSurvey and satisfactionSurvey.finish_date <= ('now'|date('Y-m-d')) %}
      <div class="row pt-5">
        <div class="alert alert-success w-auto" role="alert" id="endSurvey">
          <h4 class="alert-heading">{{ 'survey.heading'|trans }}</h4>
          <p>{{ 'survey.paragraph'|trans }}</p>
          <hr />
          <p class="mb-0">
            <a class="btn btn-secondary text-white" href="{{ path('app_survey') }}">{{ 'survey.answer'|trans }}</a>
          </p>
        </div>
      </div>
    {% endif %}

    {% if (is_granted('ROLE_RESPONSIBLE') or is_granted('ROLE_COORDINATOR') or is_granted('ROLE_TRAINER')) and currentCalendar is defined %}
      <div class="row pt-5">
        <h2>{{ 'home.current_calendar'|trans }}</h2>
        {% if currentCalendar is not empty %}
            <div id="homeCalendar"></div>
        {% else %}
          <p>{{ 'home.no_content_calendar'|trans }}</p>
        {% endif %}
      </div>
    {% endif %}

    {% if is_granted('ROLE_TRAINEE') and latestCourses is defined %}
      <div class="row pt-5">
        <h2>{{ 'course.latest_courses'|trans }}</h2>
        {% if latestCourses is not empty %}
          {% for course in latestCourses %}
            {{ include('_components/_card.html.twig', { isSummary: true }) }}
          {% endfor %}
        {% else %}
          <p>{{ 'course.no_content_latest_courses'|trans }}</p>
        {% endif %}
      </div>
    {% endif %}
    <div class="row pt-5 pb-5">
      <h2>{{ 'course.popular_courses'|trans }}</h2>
      <div class="col-12">
        {% if popularCourses is defined and popularCourses is not empty %}
          <section class="splide splide01" aria-label="{{ 'course.popular_courses'|trans }}">
            <ul class="splide__pagination"></ul>
            <div class="splide__track">
              <ul class="splide__list">
                {% for course in popularCourses %}
                  {% include '_components/_card3.html.twig' %}
                {% endfor %}
              </ul>
            </div>
          </section>
        {% else %}
          <p>{{ 'course.no_content_popular_courses'|trans }}</p>
        {% endif %}
      </div>
    </div>
    <div class="row pt-5 pb-5">
      <h2>{{ 'survey.review'|trans }}</h2>
      <div class="col-12">
        {% if traineesOpinions %}
          <section class="splide splide02" aria-label="{{ 'survey.review'|trans }}">
            <ul class="splide__pagination"></ul>
            <div class="splide__track">
              <ul class="splide__list">
                {% for opinion in traineesOpinions %}
                  {% if opinion.link starts with 'http://' or opinion.link starts with 'https://' %}
                    {% set avatarPicked = opinion.link %}
                  {% else %}
                    {% set avatarPicked = asset('avatars/' ~ opinion.link) %}
                  {% endif %}
                  <li class="splide__slide">
                    <div class="splide__slide__container">
                      <blockquote>
                        <p class="opacity-100">{{ opinion.answer|raw }}</p>
                        <footer class="opacity-100">
                          —&nbsp;<img style="border-radius: 100%;border:1px lightgrey solid;width:25px;" alt="{{ opinion.label }}" src="{{ avatarPicked }}" loading="lazy" />&nbsp;{{ opinion.first_name }}
                        </footer>
                      </blockquote>
                    </div>
                  </li>
                {% endfor %}
              </ul>
            </div>
          </section>
        {% else %}
          <p>{{ 'survey.no_content'|trans }}</p>
        {% endif %}
      </div>
    </div>
  </div>
{% endblock %}

{% block js %}
  <script src="{{ asset('js/index.js') }}"></script>
  <script>
    $(document).ready(function () {
      // Displaying tutorials if not already done and if the user is enabled to
      if (localStorage.getItem('tg_tours_complete') !== null && !localStorage.getItem('tg_tours_complete').includes('trainee-index') && {{ is_granted('ROLE_TRAINEE') ? "true" : "false" }}) {
        tg.start('trainee-index');
      } else if (localStorage.getItem('tg_tours_complete') !== null && !localStorage.getItem('tg_tours_complete').includes('trainee-end-survey-index') && $('#endSurvey').length > 0 && {{ is_granted('ROLE_TRAINEE') ? "true" : "false" }}) {
        tg.start('trainee-end-survey-index');
      }
    })
  </script>
  <script>
    var homeCalendarEl = document.getElementById('homeCalendar');
    var calendar = new FullCalendar.Calendar(homeCalendarEl, {
      timeZone: 'UTC',
      initialView: "timeGridWeek",
      headerToolbar: {
        left: 'prev,next today',
        center: 'title',
        right: 'timeGridWeek,timeGridDay,listMonth,multiMonthYear'
      },
      slotMinTime: '08:00:00',
      slotMaxTime: '19:00:00',
      locale: "{{ app.request.locale == 'en' ? 'en' : 'fr' }}",
      events: '{{ path("app_events") }}',
      editable: "{{ is_granted('ROLE_RESPONSIBLE') or is_granted('ROLE_COORDINATOR') }}", 
      selectable: "{{ is_granted('ROLE_RESPONSIBLE') or is_granted('ROLE_COORDINATOR') or is_granted('ROLE_TRAINER') }}", 
      select: function(info) {
        // Ouvre un formulaire pour ajouter un nouvel événement
        let title = prompt('{{ "event.new.title"|trans }}');
        let description = prompt('{{ "event.new.description"|trans }}');
        if (title) {
          // Crée un nouvel événement
          let newEvent = {
            title: title,
            description: description,
            start: info.startStr,
            end: info.endStr,
            allDay: info.allDay
          };

          // Ajoute l'événement au calendrier
          calendar.addEvent(newEvent);

          // Envoie l'événement au backend pour sauvegarde
          fetch('{{ path("app_events_add") }}', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify(newEvent),
          })
          .then(response => {
            if (response.ok) {
              alert('{{ "event.added"|trans }}');
            } else {
              alert('{{ "event.error"|trans }}');
            }
          })
          .catch(error => {
            console.error('Error:', error);
            alert('{{ "event.error"|trans }}');
          });
        }
        // Désélectionne le créneau sélectionné après ajout
        calendar.unselect();
      },
      eventClick: function(info) {
        // Affiche les détails de l'événement dans une modal ou un conteneur
        showEventDetails(info.event);
        // $('#calendar').fullCalendar('updateEvent', event);
      },
  });
  calendar.render();

  function showEventDetails(event) {
    // Crée ou sélectionne un conteneur/modal pour afficher les informations
    const modal = document.getElementById('event-details-modal');

    // Ajoute les informations de l'événement dans le modal
    modal.querySelector('.modal-title').textContent = event.title;
    modal.querySelector('.modal-body').innerHTML = `
      <div class="container">
        <div class="row">
          <div class="col-12" calendar-uuid="${event.extendedProps.uuid}">
            <p><strong>Date de début :</strong> ${event.start.toLocaleString()}</p>
            <p><strong>Date de fin :</strong> ${event.end ? event.end.toLocaleString() : 'Non spécifiée'}</p>
            <p><strong>Description :</strong> ${event.extendedProps.description || 'Aucune description disponible.'}</p>
          </div>
        </div>
      </div>
    `;

    // Affiche le modal
    modal.style.display = 'block';

    // Ajoute un événement pour fermer le modal
    modal.querySelector('.modal-close').addEventListener('click', function() {
      modal.style.display = 'none';
    });
  }
  </script>
{% endblock %}
