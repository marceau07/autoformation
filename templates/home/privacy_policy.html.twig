{% extends 'base.html.twig' %}

{% block title %}
  {{ 'title'|trans({}, 'privacyPolicy') }}
{% endblock %}

{% block stylesheets %}
  <style>
    p {
      text-align: justify;
    }
  </style>
{% endblock %}

{% block main %}
  <div class="container">
    <div class="row">
      <div class="col-12">
        <h1>{{ 'h1'|trans({ '%serverName%': serverName }, 'privacyPolicy') }}</h1>
      </div>
    </div>
    <div class="row pt-5 pb-5">
      <div class="col-12">
        {% for index in 0..5 %}
          {% set keyTitle = 'articles.' ~ index ~ '.title' %}
          {% set keyContent = 'articles.' ~ index ~ '.content' %}
          <h2>{{ keyTitle|trans({}, 'privacyPolicy') }}</h2>
          <p>{{ keyContent|trans({ '%serverName%': serverName, '%path%': path('app_privacy_policy') }, 'privacyPolicy')|raw }}</p>
        {% endfor %}
      </div>
    </div>
  </div>
{% endblock %}
