      <script>
        let ai_enabled = false;
        var running = false;
        function send() {
          if(!ai_enabled) {
            if (running == true) return;
            var msg = document.getElementById("message").value.trim();
            if (msg == "") return;
            running = true;
            addMsg(msg);
            //DELEAY MESSAGE RESPOSE Echo
            window.setTimeout(addResponseMsg, 1000, msg, true);
          } else {
            let message = $('#message').val().trim();
            if (message === '') return;

            var div = document.createElement("div");
            div.innerHTML = "<span style='flex-grow:1'></span><div class='chat-message-sent align-self-end'>" + message + "</div>";
            div.className = "chat-message-div";
            document.getElementById("message-box").appendChild(div);
            let chatBox = $('#message-box');
            $('#message').val('');
            chatBox.scrollTop(chatBox.prop("scrollHeight"));

            let botMessage = $('<div class="chat-message-received ia"></div>');
            chatBox.append(botMessage);
            chatBox.scrollTop(chatBox.prop("scrollHeight"));

            let safeMessage = encodeURIComponent(message)
              .replace(/%2F/g, '%252F')  // Double encodage du `/`
              .replace(/%3F/g, '%253F')  // Double encodage du `?`
              .replace(/%26/g, '%2526')  // Double encodage du `&`
              .replace(/%3D/g, '%253D')  // Double encodage du `=`
              .replace(/%23/g, '%2523')  // Double encodage du `#`
              .replace(/%2B/g, '%252B')  // Double encodage du `+`
              .replace(/%22/g, '%2522')  // Double encodage du `"`
              .replace(/%3C/g, '%253C')  // Double encodage du `<`
              .replace(/%3E/g, '%253E')  // Double encodage du `>`
              .replace(/%27/g, '%2527')  // Double encodage du `'`
              .replace(/%5C/g, '%255C'); // Double encodage du `\`
            ;
            let eventSource = new EventSource('/{{ app.request.get("_locale") }}/ai_chatbot/' + safeMessage);
            let fullMessage = "";

            eventSource.onmessage = function(event) {
                if (event.data === "[DONE]") {
                  eventSource.close(); // Fin du stream
                } else {
                  fullMessage += event.data; // Concaténer les fragments
                  botMessage.html(formatMessage(fullMessage)); // Mettre à jour l'affichage
                  chatBox.scrollTop(chatBox.prop("scrollHeight"));
                }
            };

            eventSource.onerror = function() {
              eventSource.close();
            };
          }
        }

        function formatMessage(text) {
          // Sépare les paragraphes
          let paragraphs = text.split(/\n\n+/).map(p => p.trim()); 
          
          // Transforme chaque paragraphe en <p>...</p>
          text = paragraphs.map(p => `<p>${p.replace(/\n/g, "<br>")}</p>`).join("");

          // Convertit le markdown simple en HTML
          text = text.replace(/\*\*(.*?)\*\*/g, "<strong>$1</strong>"); // Gras
          text = text.replace(/\*(.*?)\*/g, "<em>$1</em>"); // Italique
          text = text.replace(/_(.*?)_/g, "<u>$1</u>"); // Souligné

          // Convertit les blocs de code multi-lignes ```code``` en <pre><code>code</code></pre>
          text = text.replace(/```([\s\S]*?)```/g, '<pre><code>$1</code></pre>');
          
          // Convertit les blocs de code inline `code` en <code>code</code>
          text = text.replace(/`([^`]+)`/g, '<code>$1</code>');

          // Ajoute automatiquement des <p> autour du texte
          return "<p>" + text + "</p>";
        }

        function addMsg(msg) {
            var div = document.createElement("div");
            div.innerHTML =
                "<span style='flex-grow:1'></span><div class='chat-message-sent'>" +
                msg +
                "</div>";
            div.className = "chat-message-div";
            document.getElementById("message-box").appendChild(div);
            //SEND MESSAGE TO API
            document.getElementById("message").value = "";
            document.getElementById("message-box").scrollTop = document.getElementById(
                "message-box"
            ).scrollHeight;
        }

        function addResponseMsg(msg, ajax = false) {
            if (ajax) {
                var formData = new FormData();
                formData.append("form_chatbot_message", msg);
                $.ajax({
                  url: "/" + locale + "/chatbot",
                  method: "post",
                  dataType: "json",
                  data: formData,
                  processData: false,
                  contentType: false,
                  success: function (r) {
                    if (r.success) {
                      r.messages.forEach((message) => {
                        var div = document.createElement("div");
                        div.innerHTML = "<div class='chat-message-received'>" + message + "</div>";
                        div.className = "chat-message-div";
                        document.getElementById("message-box").appendChild(div);
                        document.getElementById("message-box").scrollTop = document.getElementById(
                            "message-box"
                        ).scrollHeight;
                      });
                      running = false;
                    }
                  },
                  error: function (e) {
                    console.error(e.getMessage());
                  },
                });
            } else {
              var div = document.createElement("div");
              div.innerHTML = "<div class='chat-message-received'>" + msg + "</div>";
              div.className = "chat-message-div";
              document.getElementById("message-box").appendChild(div);
              document.getElementById("message-box").scrollTop = document.getElementById(
                  "message-box"
              ).scrollHeight;
              running = false;
            }
        }
        document.getElementById("message").addEventListener("keyup", function (event) {
            if (event.keyCode === 13) {
                event.preventDefault();
                send();
            }
        });
        document.getElementById("chatbot_toggle").onclick = function () {
            if (document.getElementById("chatbot").classList.contains("collapsed")) {
              document.getElementById("chatbot").classList.remove("collapsed")
              document.getElementById("chatbot_toggle").children[1].style.display = "none"
              document.getElementById("chatbot_toggle").children[2].style.display = ""
              // Default display message
              if($('#message-box .chat-message-div').length === 0) {
                setTimeout(addResponseMsg, 1000, "{{ 'chatbot.welcome'|trans({'%user%': is_granted('ROLE_USER') ? app.user.username : 'anonymous' })|raw }}", false)
              } 
            } else {
                document.getElementById("chatbot").classList.add("collapsed")
                document.getElementById("chatbot_toggle").children[1].style.display = ""
                document.getElementById("chatbot_toggle").children[2].style.display = "none"
            }
        }

        // Gestion de l'IA
        function activateAI() {
          ai_enabled = !ai_enabled;
          document.getElementById("message").classList.toggle("ai-enabled");
        }
      </script>
