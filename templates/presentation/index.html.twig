<!DOCTYPE html>
<html lang="{{ app.request.locale }}" hrefLang="{{ app.request.locale }}">
  <head>
    <script>
      const setTheme = (theme) => {
        theme ??= localStorage.theme || 'light'
        document.documentElement.dataset.theme = theme
        document.documentElement.setAttribute('data-bs-theme', theme)
        localStorage.theme = theme
      }
      setTheme()
    </script>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, shrink-to-fit=no" />
    <meta name="theme-color" content="#317EFB" />
    <meta name="robots" content="index, follow" />
    <meta name="title" content="{{ 'global.meta_title'|trans({'%platformName%': platformName }) }}" />
    <meta name="description" content="{{ 'global.meta_description'|trans }}">
    <!--Seo Réseaux-->
    <meta property="og:title" content="{{ 'global.meta_title'|trans({'%platformName%': platformName }) }}">
    <meta property="og:type" content=website >
    <meta property="og:description" content="{{ 'global.meta_description'|trans }}">
    <meta property="og:image" content="{{ asset('/website/' ~ platformLogoPath) }}">
    <meta property="og:site_name" content="{{ 'global.meta_title'|trans({'%platformName%': platformName }) }}">
    <meta property="og:url" content="{{ app.request.getSchemeAndHttpHost() }}">
    <!--Seo Twitter-->
    <meta property="twitter:title" content="{{ 'global.meta_title'|trans({'%platformName%': platformName }) }}">
    <meta property="twitter:type" content=website >
    <meta property="twitter:description" content="{{ 'global.meta_description'|trans }}">
    <meta property="twitter:image" content="{{ asset('/website/' ~ platformLogoPath) }}">
    <meta name="twitter:card" content=summary >

    <title>{{ 'presentation.title'|trans({ '%platformName%': platformName }) }}&nbsp;- {{ 'global.meta_title'|trans({'%platformName%': platformName }) }}</title>
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="{{ asset('/images/favicon-32x32.png') }}" />
    <link rel="icon" type="image/png" sizes="16x16" href="{{ asset('/images/favicon-16x16.png') }}" />
    <link rel="manifest" href="/site.webmanifest">
    <link rel="stylesheet" href="//cdnjs.cloudflare.com/ajax/libs/font-awesome/6.2.1/css/all.min.css" integrity="sha512-MV7K8+y+gLIBoVD59lQIYicR65iaqukzvf/nwasF0nqhPay5w/9lJmVM2hMDcnK1OnMGCdVK+iQrJ7lzPJQd1w==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="stylesheet" href="//cdnjs.cloudflare.com/ajax/libs/font-awesome-animation/0.2.1/font-awesome-animation.min.css" />

    <link rel="stylesheet" href="{{ asset('css/bootstrap/bootstrap.min.css') }}" />
    <link rel="stylesheet" href="{{ asset('css/colors.css') }}" />
    <link rel="stylesheet" href="{{ asset('css/app.css') }}" />
    <link rel="stylesheet" href="{{ asset('css/presentation.css') }}" />
    <script src="https://code.jquery.com/jquery-3.7.1.min.js" integrity="sha256-/JqT3SQfawRcv/BIHPThkBvs0OEvtFFmqPF/lYI/Cxo=" crossorigin="anonymous"></script>
    <script src="{{ asset('js/bootstrap/bootstrap.bundle.min.js') }}"></script>
  </head>

  <body>
    {% include "_components/_navbar_disconnected.html.twig" %}
    
    <!-- Book a solution -->
    <div class="container-fluid text-light d-flex flex-column justify-content-evenly text-center" style="background-color: var(--coul-principale); height: 25vh;">
      <div class="row">
        <div class="col-12" id="book_platform">
          <p class="h1">{{ 'presentation.book'|trans }}</p>
        </div>
      </div>
      <div class="row">
        <div class="col-12">
          <a href="http://" target="_blank" rel="noopener noreferrer" class="btn bg-white text-dark">En savoir plus</a>
        </div>
      </div>
    </div>
    <div class="container my-5">
        <div class="text-center mb-5">
          <h1>{{ 'presentation.title'|trans({ '%platformName%': platformName }) }}</h1>
          <p class="lead">{{ 'presentation.subtitle'|trans }}</p>
        </div>

        <!-- Platform Section -->
        <div class="row align-items-center mb-5">
          <div class="col-md-6" id="web_platform">
              <h2>{{ 'presentation.platform.title'|trans }}</h2>
              <p>{{ 'presentation.platform.description'|trans({ '%platformName%': platformName }) }}</p>
              <ul class="list-unstyled">
              {% for feature in 'presentation.platform.features'|trans %}
                  <li>
                  <i class="fa-solid fa-check text-success me-2"></i>{{ feature }}
                  </li>
              {% endfor %}
              </ul>
          </div>
          <div class="col-md-6">
              <img src="{{ asset('images/platform-preview.png') }}" alt="Platform Preview" class="img-fluid rounded shadow" />
          </div>
        </div>

        <!-- Features Grid -->
        <div class="row mb-5">
          <div class="col-md-3">
              <div class="feature-card text-center p-4">
                <i class="fa-solid fa-book-open fa-3x mb-3 text-primary"></i>
                <h3>{{ 'presentation.features.courses.title'|trans }}</h3>
                <p>{{ 'presentation.features.courses.description'|trans }}</p>
              </div>
          </div>
          <div class="col-md-3">
              <div class="feature-card text-center p-4">
                <i class="fa-solid fa-comments fa-3x mb-3 text-primary"></i>
                <h3>{{ 'presentation.features.chat.title'|trans }}</h3>
                <p>{{ 'presentation.features.chat.description'|trans }}</p>
              </div>
          </div>
          <div class="col-md-3">
              <div class="feature-card text-center p-4">
                <i class="fa-solid fa-file-alt fa-3x mb-3 text-primary"></i>
                <h3>{{ 'presentation.features.documents.title'|trans }}</h3>
                <p>{{ 'presentation.features.documents.description'|trans }}</p>
              </div>
          </div>
          <div class="col-md-3">
              <div class="feature-card text-center p-4">
                <i class="fa-solid fa-calendar-alt fa-3x mb-3 text-primary"></i>
                <h3>{{ 'presentation.features.calendar.title'|trans }}</h3>
                <p>{{ 'presentation.features.calendar.description'|trans }}</p>
              </div>
          </div>
        </div>

        <!-- Mobile App Section -->
        <div class="row align-items-center text-center" id="mobile_application">
          <div class="col-md-6">
              <img src="{{ asset('images/mobile-preview.jpg') }}" alt="Mobile App Preview" class="img-fluid rounded shadow" style="max-height: 40vh;" />
          </div>
          <div class="col-md-6">
              <h2>{{ 'presentation.mobile.title'|trans }}</h2>
              <p>{{ 'presentation.mobile.description'|trans }}</p>
              <ul class="list-unstyled">
              {% for feature in 'presentation.mobile.features'|trans %}
                  <li>
                  <i class="fa-solid fa-check text-success me-2"></i>{{ feature }}
                  </li>
              {% endfor %}
              </ul>
              <div class="app-stores mt-4">
              <a href="https://play.google.com/store/apps/details?id=dev.adrar.paf" target="_blank" class="btn btn-dark me-2">
                  <i class="fab fa-google-play me-2"></i>
                  {{ 'presentation.mobile.download.android'|trans }}
              </a>
              <a href="#" class="btn btn-dark disabled" target="_blank" style="cursor:not-allowed">
                  <i class="fab fa-apple me-2"></i>
                  {{ 'presentation.mobile.download.ios'|trans }}
              </a>
              </div>
          </div>
        </div>
    </div>
    {% include "_components/_footer.html.twig" %}
    <script src="{{ asset('js/app.js') }}"></script>
    <script>
      if(typeof locale === "undefined") {
          let locale;
      }
      locale = "{{ app.request.attributes.get('_locale') }}";
    </script>
    <script src="{{ asset('js/darkMode.js') }}"></script>
  </body>
</html>