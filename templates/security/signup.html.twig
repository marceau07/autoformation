{% extends 'base.html.twig' %}

{% block title %}
  {{ 'signup.title'|trans }}
{% endblock %}

{% block stylesheets %}
  <link rel="stylesheet" href="{{ asset('css/signup.css') }}" />
{% endblock %}

{% block body %}
  <div class="container justify-content-center d-flex">
    <div class="row form-security mx-2 p-4">
      <div class="col-12 text-center">
        <img src="{{ (platformLogoPath starts with "http" or platformLogoPath starts with "https" ? platformLogoPath : asset('/website/' ~ platformLogoPath)) }}" alt="{{ platformLogoName }}" width="150" />
        <h1 class="h3 mt-5 font-weight-700">{{ 'signup.welcome'|trans({'%platformName%': platformName}) }}</h1>
      </div>
      <div class="col-12">
        <form method="post" href="{{ path('app_signup', { uuid: uuid, code: code }) }}">
          {% for flashMessage in app.session.flashbag.get('notice') %}
            {% include '_components/_alert.html.twig' with { 'type': 'success', 'bg': 'success', 'fa': 'bell', 'message': flashMessage } %}
          {% endfor %}
          {% for flashMessage in app.session.flashbag.get('info') %}
            {% include '_components/_alert.html.twig' with { 'type': 'info', 'bg': 'info', 'fa': 'info', 'message': flashMessage } %}
          {% endfor %}
          {% for flashMessage in app.session.flashbag.get('error') %}
            {% include '_components/_alert.html.twig' with { 'type': 'error', 'bg': 'danger', 'fa': 'times', 'message': flashMessage } %}
          {% endfor %}
          <input type="hidden" name="_csrf_token" value="{{ csrf_token('signup') }}" />
          <div>
            <label for="form_signup_password">{{ 'signup.new_password'|trans }}</label>
            <input type="password" name="form_signup_password" placeholder="myN3wP4sSw0rd!" autocomplete="new-password" />
          </div>
          <p>
            {{ 'recovery.return'|trans({'%path%': path('app_login')})|raw }}
          </p>
          <input class="btn btn-lg btn-primary w-100" type="submit" value="{{ 'signup.btn_new_password'|trans }}" />
        </form>
      </div>
    </div>
  </div>
{% endblock %}

{% block js %}
  <script src="{{ asset('js/signup.js') }}"></script>
{% endblock %}
