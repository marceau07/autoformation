{% extends 'base.html.twig' %}

{% block title %}
  {{ 'login.title'|trans() }}
{% endblock %}

{% block stylesheets %}
  <link rel="stylesheet" href="{{ asset('css/login.css') }}" />
{% endblock %}

{% block body %}
  <div class="container justify-content-center d-flex">
    <div class="row form-security mx-2 p-4">
      <div class="col-12 text-center">
        <img src="{{ asset('/website/' ~ platformLogoPath) }}" alt="{{ platformLogoName }}" width="150" />
        <h1 class="h3 mt-5 font-weight-700">{{ 'login.welcome'|trans({'%platformName%': platformName }) }}</h1>
      </div>
      <div class="col-12">
        <form method="post">
          {% if error %}
            <div class="alert alert-temporary alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
          {% endif %}
          {% for flashMessage in app.session.flashbag.get('notice') %}
            {% include '_components/_alert.html.twig' with { 'type': 'success', 'bg': 'success', 'fa': 'bell', 'message': flashMessage } %}
          {% endfor %}
          {% for flashMessage in app.session.flashbag.get('info') %}
            {% include '_components/_alert.html.twig' with { 'type': 'info', 'bg': 'info', 'fa': 'info', 'message': flashMessage } %}
          {% endfor %}
          {% for flashMessage in app.session.flashbag.get('error') %}
            {% include '_components/_alert.html.twig' with { 'type': 'error', 'bg': 'danger', 'fa': 'times', 'message': flashMessage } %}
          {% endfor %}

          <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}" />
          <div>
            <label for="inputUsername">{{ 'login.username'|trans() }}</label>
            <input type="text" value="{{ last_username }}" placeholder="johndoe" name="username" id="inputUsername" class="form-control border-0" autocomplete="username" required autofocus />
          </div>
          <div>
            <label for="inputPassword">{{ 'login.password'|trans() }}</label>
            <input type="password" placeholder="P4sSw0rD!" name="password" id="inputPassword" class="form-control border-0" autocomplete="current-password" required />
          </div>

          <div class="checkbox mb-3">
            <label class="d-flex align-items-center"><input type="checkbox" name="_remember_me" />&nbsp;{{ 'login.remember_me'|trans() }}</label>
          </div>
          <p>
            {{ 'login.forgot_password'|trans({'%path%': path('app_recovery', { code: null })})|raw }}
          </p>
          <button class="btn btn-lg btn-primary w-100" type="submit">{{ 'global.btn_login'|trans() }}</button>
        </form>
      </div>
    </div>
  </div>
{% endblock %}
