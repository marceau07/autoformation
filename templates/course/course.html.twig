{% extends 'base.html.twig' %}

{% block title %}
  Cours
{% endblock %}

{% block main %}
  <div class="container">
    <div class="row pt-5 cours">
      <h3>{{ 'course.text'|trans }}</h3>
      <div class="col-12">
        <div class="row pb-5" id="liste_cours">
          {% if listCourses is defined and listCourses is not empty %}
            {% for course in listCourses %}
              {% include '_components/_card.html.twig' %}
            {% endfor %}
          {% else %}
            <div class="col-3 offset-4 mt-5 text-center">
              <img src="{{ asset('/images/no_data.svg') }}" alt="{{ 'course.illustration_no_content_alt'|trans }}" />
              <h3 class="mt-3">{{ 'course.no_content'|trans }}</h3>
            </div>
          {% endif %}
        </div>
      </div>
    </div>

    <div class="row pt-5 quiz">
      <h3>{{ 'quiz.text'|trans }}</h3>
      <div class="col-12">
        <div class="row pb-5" id="liste_quizs">
          {% if listQuizzes is defined and listQuizzes is not empty %}
            {% for quiz in listQuizzes %}
            <div class="col-sm-12 col-md-4 col-lg-3 col-12 me-1 mb-3">
              <a href="{{ path('app_quiz', {'uuid': quiz.uuid}) }}" style="{{ (quiz.isAvailable ? '' : 'opacity:0.3;') }}">
                <img src="{{ quiz.qrCode }}" style="width:200px;" />
              </a>
            </div>
            {% endfor %}
          {% else %}
            <div class="col-3 offset-4 mt-5 text-center">
              <img src="{{ asset('/images/no_data.svg') }}" alt="{{ 'quiz.illustration_no_content_alt'|trans }}" />
              <h3 class="mt-3">{{ 'quiz.no_content'|trans }}</h3>
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
{% endblock %}

{% block js %}
  <script>
  $(document).ready(function () {
    if($('#liste_cours .card').length > 0) {
      if (localStorage.getItem('tg_tours_complete') !== null && !localStorage.getItem('tg_tours_complete').includes('trainee-modules') && {{ is_granted('ROLE_TRAINEE') ? "true" : "false" }}) {
        tg.group = 'trainee-modules';
        tg.activeStep = 2;
        tg.refresh();
      }
    }
  });
</script>
{% endblock %}
