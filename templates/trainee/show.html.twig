{% extends 'base.html.twig' %}

{% block title %}
  Trainee
{% endblock %}

{% block main %}
  <div class="container-fluid">
    <div class="row flex-start">
      <div class="col-3 mt-2 mb-2 text-start">
        <a href="{{ path('app_trainee_index') }}" class="btn btn-success">{{ 'global.btn_back'|trans }}</a>
      </div>
      <div class="col-6 text-center mt-2 mb-2">
        <h1>Vue sur {{ trainee.username }}</h1>
      </div>
      <div class="col-3 mt-2 mb-2 text-end">
        <a href="{{ path('app_trainee_edit', { uuid: trainee.uuid }) }}" class="btn btn-warning">{{ 'global.btn_edit'|trans }}</a>
      </div>
    </div>

    <div class="row">
      <div class="col-12">
        <table class="table table-responsive">
          <tbody>
            <tr>
              <th>Id</th>
              <td>{{ trainee.id }}</td>
            </tr>
            <tr>
              <th>Username</th>
              <td>{{ trainee.username }}</td>
            </tr>
            <tr>
              <th>LastName</th>
              <td>{{ trainee.lastName }}</td>
            </tr>
            <tr>
              <th>FirstName</th>
              <td>{{ trainee.firstName }}</td>
            </tr>
            <tr>
              <th>Roles</th>
              <td>{{ trainee.roles ? trainee.roles|json_encode:'' }}</td>
            </tr>
            <tr>
              <th>Email</th>
              <td>{{ trainee.email }}</td>
            </tr>
            <tr>
              <th>Activated</th>
              <td>{{ trainee.activated ? 'global.yes'|trans:'global.no'|trans }}</td>
            </tr>
            <tr>
              <th>TmpCode</th>
              <td>{{ trainee.tmpCode }}</td>
            </tr>
            <tr>
              <th>TmpCodeDate</th>
              <td>{{ trainee.tmpCodeDate ? trainee.tmpCodeDate|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
              <th>Signature</th>
              <td>
                {% if trainee.signature is defined and trainee.signature is not empty %}
                  <img src="{{ trainee.signature }}" alt="Signature de {{ (trainee.firstName|capitalize) ~ ' ' ~ (trainee.lastName|upper) }}" />
                {% else %}
                  Pas de signature pour {{ trainee.username }}
                {% endif %}
              </td>
            </tr>
            <tr>
              <th>Uuid</th>
              <td>{{ trainee.uuid }}</td>
            </tr>
            <tr>
              <th>Stages</th>
              <td>
               <ul>
              {% for internship in trainee.traineeInternships %}
               <li>
                {% if internship.internship is defined and internship.internship is not empty %}
                  {{ internship.internship.prospect.name }} {{ internship.internship.tutorLastName }} 
                    - <a href="{{ asset('internships/' ~ trainee.username ~ '/Convention_de_stage_' ~ internship.agreementLink ~ '.pdf') }}" target="_blank">Convention</a>: {{ (internship.agreement is not null and internship.agreement == true ? '<i class="fa-solid fa-check-to-slot text-success"></i>' : (internship.agreement is not null and internship.agreement == false ? '<i class="fa-solid fa-hourglass-start text-warning"></i>' : '<i class="fa-solid fa-x text-danger"></i>'))}} | 
                      <a href="{{ asset('internships/' ~ trainee.username ~ '/Attestation_de_stage_' ~ internship.certificateLink ~ '.pdf') }}" target="_blank">Attestation</a>: {{ (internship.certificate is not null and internship.certificate == true ? '<i class="fa-solid fa-check-to-slot text-success"></i>' : (internship.certificate is not null and internship.certificate == false ? '<i class="fa-solid fa-hourglass-start text-warning"></i>' : '<i class="fa-solid fa-x text-danger"></i>'))}} | 
                      <a href="{{ asset('internships/' ~ trainee.username ~ '/Evaluation_de_stage_' ~ internship.evaluationLink ~ '.pdf') }}" target="_blank">Évaluation</a>: {{ (internship.evaluation is not null and internship.evaluation == true ? '<i class="fa-solid fa-check-to-slot text-success"></i>' : (internship.evaluation is not null and internship.evaluation == false ? '<i class="fa-solid fa-hourglass-start text-warning"></i>' : '<i class="fa-solid fa-x text-danger"></i>'))}}
                {% else %}
                  Pas de stage
                {% endif %}
               </li>
              {% endfor %}
               </ul>
              </td>
            </tr>
            <tr>
              <th>Diploma</th>
              <td>{{ trainee.diploma }}</td>
            </tr>
          </tbody>
        </table>

        <h2>Travaux rendus</h2>
        <table class="table">
          <thead>
            <tr>
              <th>Cours</th>
              <th>Lien exercice</th>
            </tr>
          </thead>
          <tbody>
            {% for resource in trainee.traineeResources %}
              <tr>
                <td>{{ resource.courseResource.course.title }}</td>
                <td>
                  <a href="/homeworks/{{ trainee.username }}/{{ resource.label }}" target="_blank">{{ resource.label }}</a>
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </div>

    <div class="row">
      <div class="col-12">{{ include('trainee/_delete_form.html.twig') }}</div>
    </div>
  </div>
{% endblock %}
