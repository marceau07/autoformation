{% if messages is defined and messages is not empty %}
  {% for message in messages %}
    {% if message.originalMessage is not empty %}
      {# Design du message auquel l'utilisateur actuel répond #}
      <a href="#msg-{{ message.originalMessage.id }}" onclick="goToMessage({{ message.originalMessage.id }});" class="text-muted small text-decoration-none text-nowrap pb-2 {{ message.sendPeople.id ?? null == app.user.id ? 'text-end me-5' : 'text-start ms-5' }}">
        {% if message.originalMessage.sendPeople.avatar.link ?? message.originalMessage.sendPeople.avatar.link starts with 'http://' or message.sendPeople.avatar.link starts with 'https://' %}
          {% set avatarUser = message.originalMessage.sendPeople.avatar.link %}
        {% else %}
          {% set avatarUser = asset('avatars/' ~ message.originalMessage.sendPeople.avatar.link) %}
        {% endif %}
        <img src="{{ avatarUser }}" class="rounded-circle ms-3" alt="{{ message.originalMessage.sendPeople.firstName }} {{ message.originalMessage.sendPeople.lastName }}" width="20" height="20" />
        <span class="fw-600">@{{ message.originalMessage.sendPeople.id ?? null == app.user.id or message.originalMessage.sendPeople.id ?? null == app.user.id ? 'mailbox.sender.you'|trans:message.originalMessage.sendPeople.username }}</span>
        &nbsp;{{ message.originalMessage.content }}
      </a>
    {% endif %}
    <div id="msg-{{ message.id }}" class="chat-message-{{ message.sendPeople.id ?? null == app.user.id ? 'right mb-4' : 'left pb-4' }} pb-4">
      <div>
        {% if message.sendPeople.avatar.link ?? message.sendPeople.avatar.link starts with 'http://' or message.sendPeople.avatar.link starts with 'https://' %}
          {% set avatarUser = message.sendPeople.avatar.link %}
        {% else %}
          {% set avatarUser = asset('avatars/' ~ message.sendPeople.avatar.link) %}
        {% endif %}
        <img src="{{ avatarUser }}" class="rounded-circle me-1" alt="{{ message.sendPeople.firstName }} {{ message.sendPeople.lastName }}" width="40" height="40" />
      </div>
      <div class="flex-shrink-1 rounded py-2 px-3 mx-3 me-3">
        <div class="fw-bold mb-1">{{ message.sendPeople.id ?? null == app.user.id ? 'mailbox.sender.you'|trans:message.sendPeople.firstName ?? message.sendPeople.firstName ~ ' ' ~ message.sendPeople.lastName }}</div>
        {{ message.content|linkify|raw }}
        {% if message.document is defined and message.document is not empty %}
          <div class="pt-1">
            {% if message.mimeType starts with 'image/' %}
              <img class="img-thumbnail" style="height: 250px;" src="{{ asset('messages/' ~ message.document) }}" />
            {% elseif message.mimeType starts with 'video/' %}
              <video style="height: 250px;" controls>
                <source src="{{ asset('messages/' ~ message.document) }}" type="{{ message.mimeType }}" />
              </video>
            {% else %}
              <a class="border rounded px-1 py-2" style="background-color:var(--coul-principale);" href="{{ asset('messages/' ~ message.document) }}">{{ message.document }}</a>
            {% endif %}
          </div>
        {% endif %}
        <div class="small text-nowrap mt-2">{{ message.date|time_ago }}</div>
      </div>
      <div data-message="{{ message.id }}" data-content="{{ message.content|raw }}" data-media="{{ message.document }}" data-from="{{ message.sendPeople.id ?? null == app.user.id or message.sendPeople.id ?? null == app.user.id ? 'mailbox.sender.you'|trans:message.sendPeople.firstName ?? message.sendPeople.firstName ~ ' ' ~ message.sendPeople.lastName }}" onclick="replyTo(this);">
        <i class="fa-solid fa-reply"></i>
      </div>
    </div>
  {% endfor %}
{% else %}
  <div class="text-center">
    <dotlottie-player src="https://lottie.host/42d43b29-1cd3-43c6-b2d9-77c963210dd0/ahpeOAtfF5.json" style="height: 40vh;" background="transparent" speed="1" loop="true" autoplay="true"></dotlottie-player>
    <p>{{ 'mailbox.no_content'|trans }}</p>
  </div>
{% endif %}
<span class="d-none" id="go_to_bottom"></span>
