{% extends 'base.html.twig' %}

{% block title %}
  {{ 'sandbox.created'|trans }}
{% endblock %}

{% block stylesheets %}
  <link rel="stylesheet" href="{{ asset('css/account.css') }}" />
{% endblock %}

{% block main %}
  <div class="container-fluid mb-3">
    <div>
      {% include '_components/_subnavbarAccount.html.twig' with { 'choosenElement': "created_sandbox" } %}
    </div>
  
    <div class="tab-content">
      <div class="tab-pane container-fluid active" id="created-sandbox">
        <div class="container">
          <div class="row mt-3">
            <div class="col-12">
              <h2>{{ 'sandbox.created'|trans }}</h2>
            </div>
          </div>
          <div class="row mt-3">
          {% for canvas in sandboxes %}
            {% include "_components/_card5.html.twig" with {'canvas': canvas} %}
          {% endfor %}
          </div>  
        </div> 
      </div> 
    </div>
  </div>
{% endblock %}

{% block js %}
{% endblock %}